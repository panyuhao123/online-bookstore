# =====================================================================
# 线上书店 —— 环境变量示例（占位值，不含真实密钥）
# 使用方式：复制为 .env（已在 .gitignore 中，不会被提交），填入真实值后
# 在启动前加载到环境；或在 IDE Run Configuration 的 Environment variables 中配置。
# =====================================================================

# ---------------- 数据库 ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bookstore
DB_USERNAME=root
DB_PASSWORD=请填写你的MySQL密码

# ---------------- 服务端口 ----------------
# 注意：变量名带 BOOKSTORE_ 前缀，避免与运行环境自带的 SERVER_PORT 冲突
BOOKSTORE_SERVER_PORT=8080

# ---------------- JWT ----------------
# 长度需 >= 16 位，请替换为随机字符串
JWT_SECRET=请填写至少16位的随机字符串
JWT_EXPIRE_HOURS=72

# ---------------- 文件上传 ----------------
UPLOAD_BASE_DIR=./upload
UPLOAD_MAX_SIZE_MB=5

# ---------------- 跨域白名单（H5 调试与 Vue 后台） ----------------
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=http://127.0.0.1:5173

# ===== 以下为「可选加分项」，阶段 2 启用时再填写（本机已有 Redis / MinIO） =====

# ---------------- Redis（图书与分类缓存、购物车辅助） ----------------
# 本机路径：D:\redis5（先运行 redis-server.exe 再启动后端）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------------- MinIO（图书封面对象存储） ----------------
# 本机路径：D:\minio（先运行 start-minio.bat，API 端口 9000，控制台 9001）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=请填写
MINIO_SECRET_KEY=请填写
MINIO_BUCKET=bookstore
