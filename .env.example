# =====================================================================
# 线上书店 —— 环境变量示例（占位值，不含真实密钥）
# 使用方式：复制为 .env（已在 .gitignore 中，不会被提交），填入真实值后
# 在启动前加载到环境；或在 IDE Run Configuration 的 Environment variables 中配置。
# =====================================================================

# ---------------- 数据库 ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bookstore
DB_USERNAME=root
DB_PASSWORD=请填写你的MySQL密码

# ---------------- 服务端口 ----------------
# 注意：变量名带 BOOKSTORE_ 前缀，避免与运行环境自带的 SERVER_PORT 冲突
BOOKSTORE_SERVER_PORT=8080

# ---------------- JWT ----------------
# 长度需 >= 32 位（后端启动时会校验：空值 / 历史默认占位值 / 不足 32 位一律拒绝启动）
# 生成方式：openssl rand -base64 48
JWT_SECRET=请填写至少32位的随机字符串
# 令牌有效期（小时）。24-本地开发默认；生产建议 12。
# 有效期越长，令牌一旦泄露能被利用的窗口越长（JWT 过期前无法远程作废，除非命中吊销黑名单）。
JWT_EXPIRE_HOURS=24

# ---------------- 令牌吊销（退出登录在服务端生效） ----------------
# true-开启（默认）：退出登录时把令牌编号写入 Redis 黑名单，该令牌立即失效。
# false-关闭：回到「退出登录只在客户端删令牌」的旧行为，令牌仍可用到自然过期。
# 应急用途：万一黑名单逻辑异常导致正常用户被大面积拒绝，可临时设为 false 重启。
JWT_REVOCATION_ENABLED=true

# ---------------- 高德开放平台（可选） ----------------
# 用于「地址自动解析」。不配置不影响启动，只是该功能不可用（用户手动填写地址即可）。
# 未在高德控制台开启「数字签名」时，GAODE_SECRET 留空，自动降级为仅 key 模式。
GAODE_KEY=
GAODE_SECRET=

# ---------------- 接口文档（可选） ----------------
# true-开放 /doc.html（本地开发、答辩演示需要）；生产环境必须 false，避免暴露全部接口清单
DOCS_ENABLED=true

# ---------------- 登录失败锁定（防在线暴力破解） ----------------
# 同一账号连续失败 MAX_FAILURES 次即锁定 LOCK_MINUTES 分钟，锁定期内即使密码正确也拒绝。
# 设为 false 会让账号可被无限次尝试口令，仅建议在「管理员账号被锁且等不及」时临时使用。
LOGIN_GUARD_ENABLED=true
LOGIN_GUARD_MAX_FAILURES=5
LOGIN_GUARD_WINDOW_MINUTES=30
LOGIN_GUARD_LOCK_MINUTES=15

# ---------------- 文件上传 ----------------
UPLOAD_BASE_DIR=./upload
UPLOAD_MAX_SIZE_MB=5

# ---------------- 跨域白名单（H5 调试与 Vue 后台） ----------------
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=http://127.0.0.1:5173

# ===== 以下为「可选加分项」，阶段 2 启用时再填写（本机已有 Redis / MinIO） =====

# ---------------- Redis（图书与分类缓存、购物车辅助） ----------------
# 本机路径：D:\redis5（先运行 redis-server.exe 再启动后端）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---------------- MinIO（图书封面对象存储） ----------------
# 本机路径：D:\minio（先运行 start-minio.bat，API 端口 9000，控制台 9001）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=请填写
MINIO_SECRET_KEY=请填写
MINIO_BUCKET=bookstore
