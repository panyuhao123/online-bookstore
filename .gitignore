# ===== 敏感配置 =====
.env
*.local.yml
# 注意：上面的 *.local.yml 只能匹配「xxx.local.yml」（点号分隔），
# 匹配不到本项目实际使用的 application-local.yml（短横线分隔）。
# 历史上一度因此把含数据库口令 / JWT 密钥的文件提交进了仓库，所以这里显式再补一条，别删。
*-local.yml
# 模板文件需要入库，显式排除，避免被上面的规则误伤
!*-local.yml.example
!*.local.yml.example

# ===== 后端 =====
target/
!.mvn/wrapper/maven-wrapper.jar
*.log
upload/
# 运行期日志目录（logback-spring.xml 的 FILE appender 输出到这里）
logs/

# ===== Python（tools/ 下的验证脚本）=====
__pycache__/
*.py[cod]

# ===== 前端（uni-app / Vue） =====
node_modules/
dist/
.hbuilderx/
unpackage/
.hbuilderx

# ===== 编辑器与系统 =====
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db


# ===== 工具状态 =====
.workbuddy/
nul
# 校验脚本的临时目录（如 check_app_sfc.cjs 的语法检查中转文件）
tools/.tmp/
# 一键回归每次运行都会重写这些产物（可随时重跑生成），不入库；
# 结论数据以 docs/测试报告.md 为准，与 tools/baseline_*/ 的日志归档惯例一致。
tools/out/regression_*.md
tools/out/*.log
# 页面截图同样是可重跑产物（tools/shot_admin_pages.cjs、tools/shot_app_preview.cjs），
# 入库只会让仓库越来越胖；需要看图时本地跑一次即可。
tools/out/*.png

# ===== 封面抓取的一次性中间产物 =====
# fetch_covers.py / refetch_mock_covers.py 下载的候选图，仅供 covers_preview.py
# 本地拼图核对，可随时重跑生成；约 5.3 MB，不入库（本地文件保留）。
tools/covers_tmp/
tools/covers_preview.png
