<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>cn.edu.bookstore</groupId>
    <artifactId>bookstore-server</artifactId>
    <version>1.0.0</version>
    <name>bookstore-server</name>
    <description>线上书店 APP 后端服务（SpringBoot + MyBatis-Plus + MySQL）</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <hutool.version>5.8.29</hutool.version>
        <jwt.version>4.4.0</jwt.version>
        <lombok.version>1.18.34</lombok.version>
        <minio.version>8.5.12</minio.version>
        <knife4j.version>4.5.0</knife4j.version>
    </properties>

    <dependencies>
        <!-- Web 层：REST 接口 + 内嵌 Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotBlank / @NotNull 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 面向切面：统一请求日志 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!--
          运维观测（可观测性三件套之一：指标 + 健康检查 + 运行信息）。
          引入前 application.yml / application-prod.yml 里已有 management.* 配置，
          但没有这个依赖，那些配置属于「死配置」（写了也不生效）。
          端点：/actuator/health（存活探测）、/actuator/info（运行信息）、/actuator/metrics（指标）。
          同时带来 http.server.requests 指标（每个接口的调用次数/耗时），无需写代码即可观测接口性能。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 安全框架：路径级授权（/api/admin/** 需 ROLE_ADMIN）+ 方法级授权 @PreAuthorize -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 缓存：分类列表与图书详情走 Redis，减轻数据库压力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- MyBatis-Plus（Spring Boot 3 专用 starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 8 驱动（版本由 parent 统一管理） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          数据库迁移：把建表/改表脚本纳入版本管理，服务启动时自动补齐缺失的迁移。
          引入前，建库要靠人工按顺序执行 db/schema.sql + 若干 migration_v*.sql，
          换台机器极易漏执行或执行错顺序（表现为「接口 500：Unknown column」）。

          flyway-mysql 必须显式引入：Flyway 8.2 起把各数据库支持拆成独立模块，
          只加 flyway-core 会因找不到 MySQL 方言而启动报错。
          版本由 spring-boot-starter-parent 统一管理（9.22.3），不要手写版本号。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- JWT 令牌（APP 登录鉴权） -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>${jwt.version}</version>
        </dependency>

        <!-- 工具库：MD5 加盐、雪花 ID、字符串处理 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!--
          接口文档：Knife4j（OpenAPI 3 + Jakarta 版，适配 Spring Boot 3）。
          兼容性说明：knife4j 4.5.0 内部依赖 springdoc-openapi 2.3.0，
          而 Spring Boot 3.2 必须用 springdoc 2.3.0+（低版本会因 PathPatternParser
          不兼容而启动失败），因此这里不要手动降级 springdoc 版本。
          访问地址：http://127.0.0.1:8080/doc.html
        -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j.version}</version>
        </dependency>

        <!-- 对象存储：图书封面可存 MinIO（本地磁盘与 MinIO 按配置切换） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>${minio.version}</version>
        </dependency>

        <!-- Lombok：简化实体与日志对象 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>bookstore-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <!-- 生成 META-INF/build-info.properties，供 /actuator/info 展示版本与构建时间 -->
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
